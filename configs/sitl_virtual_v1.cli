# VIRTUAL SITL ONLY. No physical resource/UART settings; not a G4 restore file.
mixer QUADX
set yaw_motors_reversed = ON
map AETR1234
feature -GPS
feature -TELEMETRY
set align_board_roll = 0
set align_board_pitch = 0
set align_board_yaw = 0
set motor_pwm_protocol = PWM
set use_unsynced_pwm = ON
set motor_pwm_rate = 250
set min_command = 1000
set max_throttle = 2000
set pwr_on_arm_grace = 0
set small_angle = 25
set angle_limit = 60
set rates_type = ACTUAL
set roll_rc_rate = 7
set pitch_rc_rate = 7
set yaw_rc_rate = 7
set roll_expo = 0
set pitch_expo = 0
set yaw_expo = 0
set roll_srate = 67
set pitch_srate = 67
set yaw_srate = 67
aux 0 0 0 1700 2100 0 0
aux 1 1 1 1700 2100 0 0
