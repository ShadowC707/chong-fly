# ── Large binary weight matrices (dense float32, can be hundreds of MB) ───────
# Ignore flat legacy matrices; versioned candidates have explicit inventories.
data/reduced_models/*.npy
# Repeated builds are local reproducibility checks, not canonical candidates.
/data/reduced_models/flywire783_filtered_repeat/

# ── Raw connectome bulk data ───────────────────────────────────────────────────
data/raw_connectome/*.parquet
data/raw_connectome/*.csv
data/raw_connectome_*/*.parquet
data/raw_connectome_*/*.csv
data/annotations_*/*.tsv
data/research_sources/*.pdf

